# ========================================
# Application
# ========================================
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Docker Hub username (required for compose image name on EC2 / local pull)
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# ========================================
# MongoDB Atlas (external cloud DB)
# ========================================
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/niakylie

# ========================================
# Redis (optional — leave disabled on EC2)
# ========================================
REDIS_ENABLED=false

# ========================================
# JWT
# ========================================
JWT_SECRET=change-me
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRATION=7d

# ========================================
# Throttle / Rate Limiting
# ========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ========================================
# Admin Security
# ========================================
ADMIN_SECRET_KEY=ChangeThisSecretKeyInProduction

# ========================================
# SMTP
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========================================
# AWS S3 Storage
# ========================================
AWS_S3_REGION=ap-south-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ========================================
# Razorpay
# ========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
