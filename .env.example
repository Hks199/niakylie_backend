# ========================================
# Application
# ========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# ========================================
# MongoDB
# ========================================
MONGODB_URI=mongodb://localhost:27017/niakylie

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=600

# ========================================
# JWT
# ========================================
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ========================================
# Throttle / Rate Limiting
# ========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ========================================
# Swagger
# ========================================
SWAGGER_TITLE=Niakylie Women Collection API
SWAGGER_DESCRIPTION=Women's Fashion E-Commerce Platform API
SWAGGER_VERSION=1.0

# ========================================
# Admin Security
# ========================================
ADMIN_SECRET_KEY=ChangeThisSecretKeyInProduction

# ========================================
# AWS S3 Storage
# ========================================
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key


