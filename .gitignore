# #################################################################
# NiaKylie Backend - .gitignore
# #################################################################

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Production Build Artifacts ──
dist/
build/

# ── Environment & Secrets ──
.env
.env.local
.env.*.local
*.env
!.env.example

# ── Uploaded Static Files & Local Storage ──
public/uploads/
uploads/
/uploads
*.tmp

# ── Logs & Debugging ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ──
coverage/
.nyc_output/
*.lcov

# ── IDE & Editor Settings ──
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Operating System Junk ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker & Local Database Cache ──
.docker/
mongo-data/
redis-data/

# ── TypeScript Cache ──
*.tsbuildinfo
