# ==============================================================================
# NIAKYLIE BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Setup
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=v1
APP_NAME="Niakylie Women Collection API"
APP_URL=https://api.niakylie.com

# Database (MongoDB)
MONGODB_URI=mongodb://prod_user:SecurePass123!@mongo:27017/niakylie_prod_db?authSource=admin
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Redis Cache & Session
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SecureRedisPass123!
REDIS_TTL=600

# Authentication & JWT
JWT_SECRET=super_secret_production_jwt_key_min_32_chars_long_12345!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_production_refresh_jwt_key_98765!
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 Storage
S3_REGION=ap-south-1
S3_BUCKET=niakylie-production-media
S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
S3_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Payment Gateways (Razorpay & Stripe)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Email & Notifications (SMTP / AWS SES / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXX
EMAIL_FROM="Niakylie Women Collection <noreply@niakylie.com>"

# Throttler / Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS Allowed Origins
CORS_ORIGIN=https://niakylie.com,https://admin.niakylie.com
